---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (path: string) => `${base}${path}`;
---

<div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-10 shadow-clean-xl relative overflow-hidden" id="calculadora-fiscal">
  
  <div class="max-w-3xl mb-8">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold uppercase tracking-wider mb-3">
      Simulador Financiero DGI & MITRADEL
    </div>
    <h3 class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight">
      Calculadora Interactiva de Ahorro Fiscal (Ley 513 de Pasantías)
    </h3>
    <p class="mt-2 text-sm text-slate-600 leading-relaxed">
      Compara en tiempo real el costo laboral de una contratación tradicional en Panamá frente al régimen formativo de la Ley 513 de 2026, con 0% de cargas patronales de la CSS y 100% de deducibilidad en el Impuesto sobre la Renta.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Controls (Left Col 5) -->
    <div class="lg:col-span-5 bg-slate-50 border border-slate-200/90 rounded-2xl p-6 space-y-6">
      
      <!-- Pasantes Slider -->
      <div>
        <div class="flex justify-between items-center mb-2">
          <label for="input-pasantes" class="text-xs font-bold text-slate-700 uppercase tracking-wider">
            Cantidad de Pasantes:
          </label>
          <span id="label-pasantes" class="text-sm font-black text-slate-900 bg-white px-3 py-1 rounded-full border border-slate-200 shadow-clean">
            2 jóvenes
          </span>
        </div>
        <input 
          type="range" 
          id="input-pasantes" 
          min="1" 
          max="10" 
          value="2" 
          class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-slate-900"
        />
        <div class="flex justify-between text-[10px] text-slate-400 mt-1 font-medium">
          <span>1 (PyME)</span>
          <span>5</span>
          <span>10 (Corporativo)</span>
        </div>
      </div>

      <!-- Duración Meses Slider -->
      <div>
        <div class="flex justify-between items-center mb-2">
          <label for="input-meses" class="text-xs font-bold text-slate-700 uppercase tracking-wider">
            Duración del Programa:
          </label>
          <span id="label-meses" class="text-sm font-black text-blue-800 bg-white px-3 py-1 rounded-full border border-slate-200 shadow-clean">
            6 meses
          </span>
        </div>
        <input 
          type="range" 
          id="input-meses" 
          min="3" 
          max="12" 
          step="1"
          value="6" 
          class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-700"
        />
        <div class="flex justify-between text-[10px] text-slate-400 mt-1 font-medium">
          <span>3 meses (Mínimo)</span>
          <span>6 meses (UTP)</span>
          <span>12 meses (Tope Ley)</span>
        </div>
      </div>

      <!-- Tasa ISR Corporativa -->
      <div>
        <label for="input-isr" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
          Tasa Impuesto sobre la Renta (DGI):
        </label>
        <select id="input-isr" class="w-full bg-white border border-slate-200/90 rounded-xl px-3.5 py-2.5 text-xs font-semibold text-slate-800 focus:outline-none focus:border-blue-600 shadow-clean">
          <option value="0.25">25% (Régimen General Panamá - PyMEs y Grandes Empresas)</option>
          <option value="0.15">15% (Régimen Especial PyME hasta $200k)</option>
          <option value="0.05">5% (Sedes de Empresas Multinacionales SEM)</option>
        </select>
      </div>

      <div class="pt-2 text-[11px] text-slate-500 space-y-1 border-t border-slate-200">
        <p>• Asignación Ley 513: <strong>B/. 450.00 / mes</strong> (exenta de CSS y SE).</p>
        <p>• Régimen Ordinario: Salario base B/. 600.00 + 32.6% de cargas patronales.</p>
      </div>

    </div>

    <!-- Comparative Results (Right Col 7) -->
    <div class="lg:col-span-7 space-y-6">
      
      <!-- Big Savings Callout Card -->
      <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 text-center text-white relative shadow-clean-lg">
        <span class="inline-block px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-[#D4F634] text-slate-950 mb-2">
          Ahorro Neto Estimado para la Empresa
        </span>
        <p id="total-ahorro-neto" class="text-4xl sm:text-5xl font-black text-white font-mono tracking-tight">
          B/. 3,576.96
        </p>
        <p class="mt-2 text-xs text-slate-400 max-w-md mx-auto">
          En comparación directa con contratar bajo contrato laboral regular con cargas de la Caja de Seguro Social (CSS), Seguro Educativo y XIII Mes.
        </p>
      </div>

      <!-- Side-by-Side Comparison Table -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        
        <!-- Tarjeta Tradicional -->
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5 space-y-3">
          <div class="flex items-center justify-between border-b border-slate-200 pb-2">
            <span class="text-xs font-bold text-slate-600 uppercase tracking-wider">Contrato Regular</span>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-rose-50 text-rose-700 font-bold border border-rose-200">Con CSS</span>
          </div>
          <div class="space-y-1.5 text-xs text-slate-600">
            <div class="flex justify-between">
              <span>Salario Bruto Total:</span>
              <span id="trad-salario" class="font-mono text-slate-900 font-bold">B/. 7,200.00</span>
            </div>
            <div class="flex justify-between">
              <span>Cargas CSS (12.25%):</span>
              <span id="trad-css" class="font-mono text-rose-600 font-semibold">B/. 882.00</span>
            </div>
            <div class="flex justify-between">
              <span>Seguro Educativo (1.50%):</span>
              <span id="trad-se" class="font-mono text-rose-600 font-semibold">B/. 108.00</span>
            </div>
            <div class="flex justify-between">
              <span>XIII Mes & Prestaciones:</span>
              <span id="trad-prestaciones" class="font-mono text-rose-600 font-semibold">B/. 1,254.48</span>
            </div>
            <div class="flex justify-between text-emerald-700 border-t border-slate-200 pt-1.5 font-semibold">
              <span>Deducción ISR (DGI):</span>
              <span id="trad-deduccion" class="font-mono">- B/. 2,361.12</span>
            </div>
            <div class="flex justify-between text-sm font-extrabold border-t border-slate-200 pt-2 text-slate-950">
              <span>Costo Neto Final:</span>
              <span id="trad-costo-neto" class="font-mono">B/. 7,083.36</span>
            </div>
          </div>
        </div>

        <!-- Tarjeta Ley 513 Pasantía -->
        <div class="bg-white border-2 border-emerald-500 rounded-2xl p-5 space-y-3 shadow-clean">
          <div class="flex items-center justify-between border-b border-slate-100 pb-2">
            <span class="text-xs font-bold text-emerald-800 uppercase tracking-wider">Ley 513 Pasantía</span>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-800 font-extrabold border border-emerald-200">Exento CSS</span>
          </div>
          <div class="space-y-1.5 text-xs text-slate-600">
            <div class="flex justify-between">
              <span>Asignación ($450/m):</span>
              <span id="ley-asignacion" class="font-mono text-slate-900 font-bold">B/. 5,400.00</span>
            </div>
            <div class="flex justify-between">
              <span>Cargas CSS Patronal:</span>
              <span class="font-mono text-emerald-700 font-bold">B/. 0.00 (Exento)</span>
            </div>
            <div class="flex justify-between">
              <span>Seguro Educativo:</span>
              <span class="font-mono text-emerald-700 font-bold">B/. 0.00 (Exento)</span>
            </div>
            <div class="flex justify-between">
              <span>Póliza Privada Accidentes:</span>
              <span id="ley-poliza" class="font-mono text-slate-700 font-semibold">B/. 180.00</span>
            </div>
            <div class="flex justify-between text-emerald-700 border-t border-slate-100 pt-1.5 font-semibold">
              <span>Deducción ISR 100%:</span>
              <span id="ley-deduccion" class="font-mono">- B/. 1,395.00</span>
            </div>
            <div class="flex justify-between text-sm font-extrabold border-t border-slate-100 pt-2 text-emerald-800">
              <span>Costo Neto Final:</span>
              <span id="ley-costo-neto" class="font-mono">B/. 4,185.00</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Action Footer -->
      <div class="p-4 bg-slate-50 border border-slate-200 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
        <span class="text-slate-600 font-medium">
          ¿Deseas incorporar pasantes bajo este régimen legal?
        </span>
        <a 
          href={u('/publicar')} 
          class="px-5 py-2.5 rounded-full font-bold bg-slate-900 hover:bg-[#002B7F] text-white transition-all active:scale-[0.98] whitespace-nowrap shadow-clean"
        >
          Publicar Vacante con Ley 513 ($0) →
        </a>
      </div>

    </div>

  </div>
</div>

<script>
  const inputPasantes = document.getElementById('input-pasantes') as HTMLInputElement | null;
  const inputMeses = document.getElementById('input-meses') as HTMLInputElement | null;
  const inputIsr = document.getElementById('input-isr') as HTMLSelectElement | null;

  const labelPasantes = document.getElementById('label-pasantes');
  const labelMeses = document.getElementById('label-meses');
  const totalAhorroEl = document.getElementById('total-ahorro-neto');

  // Tradicional Elements
  const tradSalarioEl = document.getElementById('trad-salario');
  const tradCssEl = document.getElementById('trad-css');
  const tradSeEl = document.getElementById('trad-se');
  const tradPrestacionesEl = document.getElementById('trad-prestaciones');
  const tradDeduccionEl = document.getElementById('trad-deduccion');
  const tradCostoNetoEl = document.getElementById('trad-costo-neto');

  // Ley 513 Elements
  const leyAsignacionEl = document.getElementById('ley-asignacion');
  const leyPolizaEl = document.getElementById('ley-poliza');
  const leyDeduccionEl = document.getElementById('ley-deduccion');
  const leyCostoNetoEl = document.getElementById('ley-costo-neto');

  function formatB(val: number) {
    return 'B/. ' + val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function calcular() {
    const n = parseInt(inputPasantes?.value || '2', 10);
    const m = parseInt(inputMeses?.value || '6', 10);
    const tasaIsr = parseFloat(inputIsr?.value || '0.25');

    if (labelPasantes) labelPasantes.textContent = `${n} ${n === 1 ? 'joven' : 'jóvenes'}`;
    if (labelMeses) labelMeses.textContent = `${m} meses`;

    // Costo Tradicional (Salario B/. 600)
    const salarioBaseMes = 600;
    const cssPatronalMes = salarioBaseMes * 0.1225;
    const sePatronalMes = salarioBaseMes * 0.015;
    const prestacionesMes = salarioBaseMes * 0.1742;
    const costoBrutoTradMes = salarioBaseMes + cssPatronalMes + sePatronalMes + prestacionesMes;
    
    const tradSalarioTotal = salarioBaseMes * n * m;
    const tradCssTotal = cssPatronalMes * n * m;
    const tradSeTotal = sePatronalMes * n * m;
    const tradPrestacionesTotal = prestacionesMes * n * m;
    const tradGastoTotal = costoBrutoTradMes * n * m;
    const tradDeduccionTotal = tradGastoTotal * tasaIsr;
    const tradCostoNetoTotal = tradGastoTotal - tradDeduccionTotal;

    // Costo Ley 513 (Asignación B/. 450 fija)
    const asignacionMes = 450;
    const polizaMes = 15;
    const costoBrutoLeyMes = asignacionMes + polizaMes;
    
    const leyAsignacionTotal = asignacionMes * n * m;
    const leyPolizaTotal = polizaMes * n * m;
    const leyGastoTotal = costoBrutoLeyMes * n * m;
    const leyDeduccionTotal = leyGastoTotal * tasaIsr;
    const leyCostoNetoTotal = leyGastoTotal - leyDeduccionTotal;

    const ahorroNeto = tradCostoNetoTotal - leyCostoNetoTotal;

    // Render results
    if (totalAhorroEl) totalAhorroEl.textContent = formatB(ahorroNeto);

    if (tradSalarioEl) tradSalarioEl.textContent = formatB(tradSalarioTotal);
    if (tradCssEl) tradCssEl.textContent = formatB(tradCssTotal);
    if (tradSeEl) tradSeEl.textContent = formatB(tradSeTotal);
    if (tradPrestacionesEl) tradPrestacionesEl.textContent = formatB(tradPrestacionesTotal);
    if (tradDeduccionEl) tradDeduccionEl.textContent = '- ' + formatB(tradDeduccionTotal);
    if (tradCostoNetoEl) tradCostoNetoEl.textContent = formatB(tradCostoNetoTotal);

    if (leyAsignacionEl) leyAsignacionEl.textContent = formatB(leyAsignacionTotal);
    if (leyPolizaEl) leyPolizaEl.textContent = formatB(leyPolizaTotal);
    if (leyDeduccionEl) leyDeduccionEl.textContent = '- ' + formatB(leyDeduccionTotal);
    if (leyCostoNetoEl) leyCostoNetoEl.textContent = formatB(leyCostoNetoTotal);
  }

  inputPasantes?.addEventListener('input', calcular);
  inputMeses?.addEventListener('input', calcular);
  inputIsr?.addEventListener('change', calcular);

  // Initial calculation
  calcular();
</script>
