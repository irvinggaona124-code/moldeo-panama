---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (path: string) => `${base}${path}`;
---

<section class="relative overflow-hidden pt-12 pb-20 md:pt-20 md:pb-28 bg-gradient-to-b from-slate-900 via-slate-950 to-slate-950">
  <!-- Background Glow & Decorative Elements -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-blue-600/15 blur-[120px] rounded-full pointer-events-none"></div>
  <div class="absolute top-1/3 right-10 w-[300px] h-[300px] bg-emerald-500/10 blur-[100px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Tagline Badge -->
    <div class="flex justify-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-800/80 border border-slate-700/80 text-xs text-slate-300 shadow-sm backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="font-semibold text-emerald-400">Pasantías Ley 513 Sancionada</span>
        <span class="text-slate-500">|</span>
        <span>0 Meses de Experiencia Exigida</span>
      </div>
    </div>

    <!-- Main Headings -->
    <div class="mt-6 text-center max-w-4xl mx-auto">
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight">
        El Portal Exclusivo para Talento Universitario <span class="bg-gradient-to-r from-blue-400 via-indigo-300 to-emerald-400 bg-clip-text text-transparent">Cero Experiencia</span> en Panamá
      </h1>
      
      <p class="mt-6 text-base sm:text-lg lg:text-xl text-slate-300 leading-relaxed font-normal max-w-3xl mx-auto">
        Conectamos a estudiantes de la <strong class="text-white font-semibold">UTP, UP, USMA y universidades de Panamá</strong> con empresas dispuestas a moldear talento desde cero. Sin filtros por historial laboral previo, con incentivos de ahorro fiscal y estipendios de hasta <strong class="text-emerald-400 font-semibold">B/. 450.00 libres de cargas de Seguro Social</strong>.
      </p>

      <!-- Primary Action CTAs -->
      <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href={u('/vacantes')} 
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-sm bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 hover:from-blue-500 hover:to-indigo-600 text-white shadow-lg shadow-blue-600/30 hover:shadow-blue-600/40 transition-all hover:scale-[1.02] flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          Explorar 30 Vacantes Verificadas
        </a>

        <a 
          href={u('/talento-moldeable')} 
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-sm bg-slate-800 hover:bg-slate-700/80 text-slate-200 border border-slate-700 transition-all hover:scale-[1.02] flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          Directorio de Talento Moldeable
        </a>

        <a 
          href={u('/publicar')} 
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl font-bold text-sm bg-emerald-600 hover:bg-emerald-500 text-white shadow-lg shadow-emerald-600/20 transition-all hover:scale-[1.02] flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Publicar Vacante Gratis ($0)
        </a>
      </div>

      <!-- Trust highlights -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs text-slate-400">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          100% Gratuito para Estudiantes (Art. 22 C. de Trabajo)
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          Protección de Datos Garantizada (Ley 81 ANTAI)
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          Validación Oficial EF SET & RIASEC
        </span>
      </div>

    </div>

    <!-- Macro Metrics Cards (Datos Reales INEC 2025/2026) -->
    <div class="mt-16 grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 text-center shadow-lg hover:border-slate-700 transition-colors">
        <p class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">113,347</p>
        <p class="mt-1 text-xs sm:text-sm font-semibold text-rose-400">Jóvenes Desocupados en Panamá</p>
        <p class="mt-1 text-[11px] text-slate-500">Tasa de 19.9% juvenil (INEC 2025/26)</p>
      </div>

      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 text-center shadow-lg hover:border-slate-700 transition-colors">
        <p class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">193,773</p>
        <p class="mt-1 text-xs sm:text-sm font-semibold text-blue-400">Universitarios Matriculados</p>
        <p class="mt-1 text-[11px] text-slate-500">60.3% en UP y UTP (INEC 2024/25)</p>
      </div>

      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 text-center shadow-lg hover:border-slate-700 transition-colors">
        <p class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">0 Meses</p>
        <p class="mt-1 text-xs sm:text-sm font-semibold text-emerald-400">Experiencia Previa Exigida</p>
        <p class="mt-1 text-[11px] text-slate-500">Pacto estricto de empresa formadora</p>
      </div>

      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 text-center shadow-lg hover:border-slate-700 transition-colors">
        <p class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">B/. 450</p>
        <p class="mt-1 text-xs sm:text-sm font-semibold text-amber-400">Asignación Ley 513</p>
        <p class="mt-1 text-[11px] text-slate-500">100% Deducible de ISR, sin CSS patronal</p>
      </div>

    </div>

  </div>
</section>
