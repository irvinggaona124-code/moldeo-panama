---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (path: string) => `${base}${path}`;

interface Props {
  activePage?: string;
}

const { activePage = 'home' } = Astro.props;
---

<header class="sticky top-0 z-50 pt-3 pb-2 px-4 sm:px-6">
  <!-- Subtle Top Banner for Ley 513 Announcement -->
  <div class="max-w-6xl mx-auto mb-2.5">
    <div class="bg-slate-900 text-white rounded-full py-1.5 px-4 text-xs font-medium flex items-center justify-between shadow-sm">
      <div class="flex items-center gap-2 mx-auto sm:mx-0">
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-[#D4F634] text-slate-950 uppercase tracking-wider">
          Ley 513 Vigente
        </span>
        <span class="text-slate-300 text-[11px] sm:text-xs">
          Pasantías en Panamá: B/. 450.00/mes 100% deducible y 0% cargas de Seguro Social.
        </span>
      </div>
      <a href={u('/calculadora-fiscal')} class="hidden md:inline-flex items-center gap-1 text-[11px] text-[#D4F634] hover:underline font-semibold">
        Simulador DGI & CSS →
      </a>
    </div>
  </div>

  <!-- Floating Pill Navbar -->
  <div class="max-w-6xl mx-auto bg-white/90 backdrop-blur-md border border-slate-200/80 rounded-full px-4 sm:px-6 h-16 flex items-center justify-between shadow-pill transition-all">
    
    <!-- Brand Logo -->
    <a href={u('/')} class="flex items-center gap-2.5 group">
      <div class="w-9 h-9 rounded-full bg-slate-900 flex items-center justify-center text-white group-hover:bg-[#002B7F] transition-colors shadow-sm">
        <svg class="w-4 h-4 text-[#D4F634]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="text-lg font-black tracking-tight text-slate-900">
          Moldeo<span class="text-blue-700">.pa</span>
        </span>
        <span class="text-[9px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 hidden sm:inline-block">
          Cero Exp
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1 text-xs font-semibold text-slate-600">
      <a 
        href={u('/vacantes')} 
        class={`px-3.5 py-2 rounded-full transition-all ${activePage === 'vacantes' ? 'text-slate-950 bg-slate-100 font-bold' : 'hover:text-slate-950 hover:bg-slate-50'}`}
      >
        Vacantes
      </a>
      <a 
        href={u('/talento-moldeable')} 
        class={`px-3.5 py-2 rounded-full transition-all ${activePage === 'talento' ? 'text-slate-950 bg-slate-100 font-bold' : 'hover:text-slate-950 hover:bg-slate-50'}`}
      >
        Directorio Anti-CV
      </a>
      <a 
        href={u('/calculadora-fiscal')} 
        class={`px-3.5 py-2 rounded-full transition-all ${activePage === 'calculadora' ? 'text-slate-950 bg-slate-100 font-bold' : 'hover:text-slate-950 hover:bg-slate-50'}`}
      >
        Calculadora Fiscal
      </a>
      <a 
        href={u('/test-vocacional')} 
        class={`px-3.5 py-2 rounded-full transition-all ${activePage === 'test' ? 'text-slate-950 bg-slate-100 font-bold' : 'hover:text-slate-950 hover:bg-slate-50'}`}
      >
        Test RIASEC
      </a>
      <a 
        href={u('/kit-practica')} 
        class={`px-3.5 py-2 rounded-full transition-all ${activePage === 'kit' ? 'text-slate-950 bg-slate-100 font-bold' : 'hover:text-slate-950 hover:bg-slate-50'}`}
      >
        Kit Práctica
      </a>
      <a 
        href={u('/empresas')} 
        class={`px-3.5 py-2 rounded-full transition-all ${activePage === 'empresas' ? 'text-slate-950 bg-slate-100 font-bold' : 'hover:text-slate-950 hover:bg-slate-50'}`}
      >
        Empresas
      </a>
    </nav>

    <!-- Right Action Buttons -->
    <div class="hidden sm:flex items-center gap-2.5">
      <a 
        href={u('/registro-estudiante')} 
        class="px-4 py-2 rounded-full text-xs font-semibold text-slate-700 hover:text-slate-950 hover:bg-slate-100 transition-all active:scale-[0.98]"
      >
        Soy Estudiante
      </a>
      <a 
        href={u('/publicar')} 
        class="px-5 py-2 rounded-full text-xs font-extrabold bg-slate-900 hover:bg-[#002B7F] text-white shadow-sm hover:shadow transition-all active:scale-[0.98] flex items-center gap-1.5"
      >
        <span>Publicar $0</span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#D4F634]"></span>
      </a>
    </div>

    <!-- Mobile Menu Trigger -->
    <div class="flex items-center gap-2 lg:hidden">
      <a 
        href={u('/publicar')} 
        class="px-3 py-1.5 rounded-full text-xs font-bold bg-slate-900 text-white"
      >
        Publicar
      </a>
      <button 
        type="button" 
        id="mobile-menu-toggle"
        class="p-2 rounded-full text-slate-600 hover:text-slate-950 hover:bg-slate-100 focus:outline-none"
        aria-label="Menú principal"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden lg:hidden max-w-6xl mx-auto mt-2 bg-white border border-slate-200 rounded-3xl p-4 shadow-xl space-y-1.5 text-sm font-semibold">
    <a href={u('/vacantes')} class="block px-4 py-2.5 rounded-xl text-slate-700 hover:bg-slate-50">
      🔍 Vacantes Cero Experiencia (30 Activas)
    </a>
    <a href={u('/talento-moldeable')} class="block px-4 py-2.5 rounded-xl text-slate-700 hover:bg-slate-50">
      🎓 Directorio de Moldeables (Anti-CV)
    </a>
    <a href={u('/calculadora-fiscal')} class="block px-4 py-2.5 rounded-xl text-slate-700 hover:bg-slate-50">
      💰 Calculadora Fiscal (Ley 513)
    </a>
    <a href={u('/test-vocacional')} class="block px-4 py-2.5 rounded-xl text-slate-700 hover:bg-slate-50">
      🧠 Test Vocacional RIASEC
    </a>
    <a href={u('/kit-practica')} class="block px-4 py-2.5 rounded-xl text-slate-700 hover:bg-slate-50">
      📑 Kit de Práctica (Gantt & Cartas)
    </a>
    <a href={u('/empresas')} class="block px-4 py-2.5 rounded-xl text-slate-700 hover:bg-slate-50">
      🏢 Servicios B2B para Empresas
    </a>
    <div class="pt-3 border-t border-slate-100 flex flex-col gap-2">
      <a href={u('/registro-estudiante')} class="w-full text-center py-2.5 rounded-full text-xs font-bold text-slate-700 bg-slate-100">
        Crear mi Perfil de Moldeabilidad (Gratis)
      </a>
      <a href={u('/publicar')} class="w-full text-center py-2.5 rounded-full text-xs font-bold bg-slate-900 text-white">
        Publicar Vacante Formadora $0
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggleBtn && menu) {
    toggleBtn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
