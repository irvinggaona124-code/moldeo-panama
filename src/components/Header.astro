---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (path: string) => `${base}${path}`;

interface Props {
  activePage?: string;
}

const { activePage = 'home' } = Astro.props;
---

<header class="sticky top-0 z-50 bg-slate-900/95 backdrop-blur-md border-b border-slate-800 text-white">
  <!-- Top notification bar -->
  <div class="bg-gradient-to-r from-blue-700 via-indigo-700 to-blue-800 text-white text-xs py-1.5 px-4 text-center font-medium shadow-inner flex items-center justify-center gap-2">
    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-400 text-slate-950 uppercase tracking-wider animate-pulse">
      Ley 513 Vigente
    </span>
    <span>
      Pasantías formativas en Panamá con asignación de B/. 450.00 libres de cargas de CSS y 100% deducibles de impuestos.
    </span>
    <a href={u('/calculadora-fiscal')} class="underline hover:text-amber-200 ml-1 font-semibold hidden md:inline">
      Calcular ahorro fiscal →
    </a>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href={u('/')} class="flex items-center gap-3 group">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-emerald-500 flex items-center justify-center text-white shadow-lg shadow-blue-500/20 group-hover:scale-105 transition-transform duration-200">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xl font-extrabold tracking-tight text-white group-hover:text-blue-400 transition-colors">
              Moldeo<span class="text-emerald-400 font-black">.pa</span>
            </span>
            <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-300 border border-blue-500/30">
              0 Experiencia
            </span>
          </div>
          <p class="text-[11px] text-slate-400 tracking-tight font-medium hidden sm:block">
            Talento Universitario & Empresas Formadoras
          </p>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2 text-sm font-medium">
        <a 
          href={u('/vacantes')} 
          class={`px-3 py-2 rounded-lg transition-colors ${activePage === 'vacantes' ? 'text-white bg-slate-800' : 'text-slate-300 hover:text-white hover:bg-slate-800/60'}`}
        >
          Vacantes Cero Exp.
        </a>
        <a 
          href={u('/talento-moldeable')} 
          class={`px-3 py-2 rounded-lg transition-colors ${activePage === 'talento' ? 'text-white bg-slate-800' : 'text-slate-300 hover:text-white hover:bg-slate-800/60'}`}
        >
          Directorio Moldeable
        </a>
        <a 
          href={u('/calculadora-fiscal')} 
          class={`px-3 py-2 rounded-lg transition-colors ${activePage === 'calculadora' ? 'text-white bg-slate-800' : 'text-slate-300 hover:text-white hover:bg-slate-800/60'}`}
        >
          Calculadora Fiscal
        </a>
        <a 
          href={u('/test-vocacional')} 
          class={`px-3 py-2 rounded-lg transition-colors ${activePage === 'test' ? 'text-white bg-slate-800' : 'text-slate-300 hover:text-white hover:bg-slate-800/60'}`}
        >
          Test RIASEC
        </a>
        <a 
          href={u('/kit-practica')} 
          class={`px-3 py-2 rounded-lg transition-colors ${activePage === 'kit' ? 'text-white bg-slate-800' : 'text-slate-300 hover:text-white hover:bg-slate-800/60'}`}
        >
          Kit de Práctica
        </a>
        <a 
          href={u('/empresas')} 
          class={`px-3 py-2 rounded-lg transition-colors ${activePage === 'empresas' ? 'text-white bg-slate-800' : 'text-slate-300 hover:text-white hover:bg-slate-800/60'}`}
        >
          Para Empresas
        </a>
      </nav>

      <!-- Action Buttons -->
      <div class="hidden sm:flex items-center gap-3">
        <a 
          href={u('/registro-estudiante')} 
          class="px-4 py-2 rounded-lg text-xs font-semibold text-slate-200 hover:text-white hover:bg-slate-800 border border-slate-700 transition-colors"
        >
          Crear Perfil Moldeable
        </a>
        <a 
          href={u('/publicar')} 
          class="px-4 py-2 rounded-lg text-xs font-bold bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white shadow-md shadow-emerald-500/20 transition-all hover:shadow-emerald-500/30"
        >
          Publicar Vacante $0
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="flex items-center gap-2 lg:hidden">
        <a 
          href={u('/publicar')} 
          class="px-3 py-1.5 rounded-lg text-xs font-bold bg-emerald-500 text-white"
        >
          Publicar
        </a>
        <button 
          type="button" 
          id="mobile-menu-toggle"
          class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 focus:outline-none"
          aria-label="Menú principal"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-800 bg-slate-900 px-4 pt-3 pb-6 space-y-2">
    <a href={u('/vacantes')} class="block px-3 py-2 rounded-lg text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800">
      🔍 Vacantes Cero Experiencia
    </a>
    <a href={u('/talento-moldeable')} class="block px-3 py-2 rounded-lg text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800">
      🎓 Directorio de Talento Moldeable
    </a>
    <a href={u('/calculadora-fiscal')} class="block px-3 py-2 rounded-lg text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800">
      💰 Calculadora de Ahorro Fiscal (Ley 513)
    </a>
    <a href={u('/test-vocacional')} class="block px-3 py-2 rounded-lg text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800">
      🧠 Test Vocacional RIASEC
    </a>
    <a href={u('/kit-practica')} class="block px-3 py-2 rounded-lg text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800">
      📑 Kit de Práctica (Gantt & Cartas)
    </a>
    <a href={u('/empresas')} class="block px-3 py-2 rounded-lg text-base font-medium text-slate-300 hover:text-white hover:bg-slate-800">
      🏢 Servicios para Empresas Formadoras
    </a>
    <div class="pt-4 flex flex-col gap-2">
      <a href={u('/registro-estudiante')} class="w-full text-center py-2.5 rounded-lg text-sm font-semibold text-slate-200 bg-slate-800 border border-slate-700">
        Registrar Perfil Moldeable (Gratis)
      </a>
      <a href={u('/publicar')} class="w-full text-center py-2.5 rounded-lg text-sm font-bold bg-emerald-500 text-white">
        Publicar Vacante Formadora $0
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggleBtn && menu) {
    toggleBtn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
