---
import Layout from '../layouts/Layout.astro';
import PactoFormadora from '../components/PactoFormadora.astro';
import CalculadoraFiscal from '../components/CalculadoraFiscal.astro';
---

<Layout 
  title="Servicios para Empresas Formadoras en Panamá (Ley 513 y Yappy B2B)"
  description="Soluciones de talento universitario para empresas en Panamá. Publicación gratis $0, shortlists con video-pitch por B/. 15 vía Yappy Comercial y asesoría en la Ley 513."
  activePage="empresas"
>
  
  <div class="py-12 md:py-16 bg-slate-900 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-bold uppercase tracking-wider mb-4">
        Ecosistema B2B Panamá
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Moldea Talento Universitario en tu Empresa
      </h1>
      <p class="mt-4 text-base text-slate-300 leading-relaxed">
        Reduce tus costos de selección, aprovecha el <strong class="text-emerald-400 font-semibold">100% de deducibilidad fiscal de la Ley 513</strong> y accede a estudiantes pre-calificados con video de presentación e inglés evaluado.
      </p>
    </div>
  </div>

  <!-- Pricing & B2B Solutions Grid -->
  <div class="py-16 md:py-24 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Esquema de Servicios B2B Transparente (Sin Suscripciones Ocultas)
        </h2>
        <p class="mt-2 text-xs sm:text-sm text-slate-400">
          Precios accesibles aprobables por caja menuda o Yappy Comercial desde cualquier cuenta en Panamá.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        
        <!-- Plan 1: Publicación Básica -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 flex flex-col justify-between shadow-lg">
          <div>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-800 text-slate-300 border border-slate-700">
              Inicio Rápido
            </span>
            <h3 class="text-lg font-bold text-white mt-3">Aviso Gratuito</h3>
            <p class="text-xs text-slate-400 mt-1">Para PyMEs que desean recibir candidatos sin costo.</p>
            <div class="mt-5 text-3xl font-black text-white font-mono">
              B/. 0.00
            </div>
            <ul class="mt-6 space-y-2.5 text-xs text-slate-300 border-t border-slate-800 pt-5">
              <li class="flex items-center gap-2">✓ Publicación por 30 días</li>
              <li class="flex items-center gap-2">✓ Postulaciones ilimitadas directas</li>
              <li class="flex items-center gap-2">✓ Sello de Empresa Formadora</li>
              <li class="flex items-center gap-2">✓ Sin costo de intermediación</li>
            </ul>
          </div>
          <div class="mt-8 pt-4 border-t border-slate-800">
            <a href="/moldeo-panama/publicar" class="w-full block text-center py-2.5 rounded-xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-white transition-colors">
              Publicar Gratis ($0)
            </a>
          </div>
        </div>

        <!-- Plan 2: Shortlist Top 10 + Video-Pitch (El más popular) -->
        <div class="bg-slate-900 border-2 border-emerald-500/50 rounded-2xl p-6 flex flex-col justify-between relative shadow-xl shadow-emerald-950/20">
          <div class="absolute -top-3 right-6 px-3 py-0.5 rounded-full bg-emerald-500 text-slate-950 text-[10px] font-bold uppercase tracking-wider">
            Más Elegido
          </div>
          <div>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
              Filtro y Velocidad
            </span>
            <h3 class="text-lg font-bold text-white mt-3">Shortlist Top 10 Moldeables</h3>
            <p class="text-xs text-slate-400 mt-1">Contacto directo y video de 60s de los mejores 10.</p>
            <div class="mt-5 text-3xl font-black text-emerald-400 font-mono">
              B/. 15.00
            </div>
            <p class="text-[10px] text-slate-500 mt-0.5">Pago único por vacante · Vía Yappy</p>
            <ul class="mt-6 space-y-2.5 text-xs text-slate-300 border-t border-slate-800 pt-5">
              <li class="flex items-center gap-2">✓ Top 10 candidatos ordenados</li>
              <li class="flex items-center gap-2">✓ WhatsApp y teléfono directo</li>
              <li class="flex items-center gap-2">✓ Desbloqueo de Video-Pitch 60s</li>
              <li class="flex items-center gap-2">✓ Certificado verificable EF SET</li>
              <li class="flex items-center gap-2">✓ Guía rápida convalidación Ley 513</li>
            </ul>
          </div>
          <div class="mt-8 pt-4 border-t border-slate-800">
            <a href="/moldeo-panama/talento-moldeable" class="w-full block text-center py-2.5 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-500 text-white shadow-md shadow-emerald-600/30 transition-all">
              Desbloquear vía Yappy
            </a>
          </div>
        </div>

        <!-- Plan 3: Vacante Destacada -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 flex flex-col justify-between shadow-lg">
          <div>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-blue-500/10 text-blue-300 border border-blue-500/30">
              Máxima Visibilidad
            </span>
            <h3 class="text-lg font-bold text-white mt-3">Aviso Destacado + Red</h3>
            <p class="text-xs text-slate-400 mt-1">Ubicación preferencial y difusión universitaria.</p>
            <div class="mt-5 text-3xl font-black text-white font-mono">
              B/. 15.00
            </div>
            <p class="text-[10px] text-slate-500 mt-0.5">Por 15 días de difusión masiva</p>
            <ul class="mt-6 space-y-2.5 text-xs text-slate-300 border-t border-slate-800 pt-5">
              <li class="flex items-center gap-2">✓ Posición fija en la vitrina</li>
              <li class="flex items-center gap-2">✓ Difusión en WhatsApp de facultades</li>
              <li class="flex items-center gap-2">✓ Insignia visual destacada</li>
              <li class="flex items-center gap-2">✓ Enlace directo a tu web de empleo</li>
            </ul>
          </div>
          <div class="mt-8 pt-4 border-t border-slate-800">
            <a href="/moldeo-panama/publicar" class="w-full block text-center py-2.5 rounded-xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-white transition-colors">
              Destacar mi Vacante
            </a>
          </div>
        </div>

        <!-- Plan 4: Employer Branding Anual -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 flex flex-col justify-between shadow-lg">
          <div>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-300 border border-amber-500/30">
              Marca Empleadora
            </span>
            <h3 class="text-lg font-bold text-white mt-3">Sello Formador Verificado</h3>
            <p class="text-xs text-slate-400 mt-1">Presencia institucional ante universidades.</p>
            <div class="mt-5 text-3xl font-black text-white font-mono">
              B/. 49.00
            </div>
            <p class="text-[10px] text-slate-500 mt-0.5">Membresía anual corporativa</p>
            <ul class="mt-6 space-y-2.5 text-xs text-slate-300 border-t border-slate-800 pt-5">
              <li class="flex items-center gap-2">✓ Perfil corporativo de formación</li>
              <li class="flex items-center gap-2">✓ Publicaciones destacadas ilimitadas</li>
              <li class="flex items-center gap-2">✓ Informe de percepción estudiantil</li>
              <li class="flex items-center gap-2">✓ Factura fiscal panameña DGI</li>
            </ul>
          </div>
          <div class="mt-8 pt-4 border-t border-slate-800">
            <a href="mailto:empresas@moldeo.pa" class="w-full block text-center py-2.5 rounded-xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-white transition-colors">
              Consultar Membresía
            </a>
          </div>
        </div>

      </div>

    </div>
  </div>

  <!-- Yappy Comercial Callout -->
  <div class="py-16 bg-slate-900 border-y border-slate-800" id="yappy">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="w-16 h-16 rounded-2xl bg-blue-600/10 text-blue-400 border border-blue-500/30 flex items-center justify-center mx-auto text-3xl">
        💙
      </div>
      <h3 class="text-2xl font-bold text-white">
        Pagos Inmediatos sin Burocracia con Yappy Comercial
      </h3>
      <p class="text-sm text-slate-300 max-w-xl mx-auto leading-relaxed">
        Paga tus reportes o servicios destacados directamente desde la App de Banco General buscando nuestro directorio comercial:
      </p>
      <div class="inline-block bg-slate-950 px-6 py-3 rounded-2xl border border-slate-800 font-mono text-xl font-bold text-amber-400">
        @moldeopanama
      </div>
      <p class="text-xs text-slate-500">
        Para pagos corporativos internacionales aceptamos Visa, Mastercard y Amex vía Tilopay.
      </p>
    </div>
  </div>

  <!-- Calculadora Fiscal Integration -->
  <div class="py-16 md:py-24 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <CalculadoraFiscal />
    </div>
  </div>

  <PactoFormadora />

</Layout>
