---
import Layout from '../layouts/Layout.astro';
import PactoFormadora from '../components/PactoFormadora.astro';
import CalculadoraFiscal from '../components/CalculadoraFiscal.astro';
---

<Layout 
  title="Servicios para Empresas Formadoras en Panamá (Ley 513 y Yappy B2B)"
  description="Soluciones de talento universitario para empresas en Panamá. Publicación gratis $0, shortlists con video-pitch por B/. 15 vía Yappy Comercial y asesoría en la Ley 513."
  activePage="empresas"
>
  
  <div class="py-12 md:py-16 bg-white border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold uppercase tracking-wider mb-3">
        Ecosistema B2B Panamá
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-950 tracking-tight">
        Moldea Talento Universitario en tu Empresa
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Reduce tus costos de selección, aprovecha el <strong class="text-emerald-700 font-bold">100% de deducibilidad fiscal de la Ley 513</strong> y accede a estudiantes pre-calificados con video de presentación e inglés evaluado.
      </p>
    </div>
  </div>

  <!-- Pricing & B2B Solutions Grid -->
  <div class="py-16 md:py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl sm:text-4xl font-black text-slate-950 tracking-tight">
          Esquema de Servicios B2B Transparente
        </h2>
        <p class="mt-2 text-xs sm:text-sm text-slate-500">
          Precios accesibles aprobables por caja menuda o Yappy Comercial desde cualquier cuenta en Panamá.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        
        <!-- Plan 1: Publicación Básica -->
        <div class="bg-white border border-slate-200 rounded-3xl p-6 flex flex-col justify-between shadow-clean hover:shadow-clean-lg transition-all">
          <div>
            <span class="px-3 py-1 rounded-full text-[10px] font-bold bg-slate-100 text-slate-700">
              Inicio Rápido
            </span>
            <h3 class="text-lg font-bold text-slate-950 mt-3">Aviso Gratuito</h3>
            <p class="text-xs text-slate-500 mt-1">Para PyMEs que desean recibir candidatos sin costo.</p>
            <div class="mt-5 text-3xl font-black text-slate-950 font-mono">
              B/. 0.00
            </div>
            <ul class="mt-6 space-y-2.5 text-xs text-slate-600 border-t border-slate-100 pt-5">
              <li class="flex items-center gap-2">✓ Publicación por 30 días</li>
              <li class="flex items-center gap-2">✓ Postulaciones ilimitadas directas</li>
              <li class="flex items-center gap-2">✓ Sello de Empresa Formadora</li>
              <li class="flex items-center gap-2">✓ Sin costo de intermediación</li>
            </ul>
          </div>
          <div class="mt-8 pt-4 border-t border-slate-100">
            <a href="/moldeo-panama/publicar" class="w-full block text-center py-2.5 rounded-full text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-900 transition-colors">
              Publicar Gratis ($0)
            </a>
          </div>
        </div>

        <!-- Plan 2: Shortlist Top 10 + Video-Pitch (El más popular) -->
        <div class="bg-white border-2 border-slate-950 rounded-3xl p-6 flex flex-col justify-between relative shadow-clean-xl hover:shadow-clean-xl transition-all">
          <div class="absolute -top-3.5 right-6 px-3 py-0.5 rounded-full bg-[#D4F634] text-slate-950 text-[10px] font-black uppercase tracking-wider">
            Más Elegido
          </div>
          <div>
            <span class="px-3 py-1 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
              Filtro y Velocidad
            </span>
            <h3 class="text-lg font-bold text-slate-950 mt-3">Shortlist Top 10 Moldeables</h3>
            <p class="text-xs text-slate-500 mt-1">Contacto directo y video de 60s de los mejores 10.</p>
            <div class="mt-5 text-3xl font-black text-slate-950 font-mono">
              B/. 15.00
            </div>
            <p class="text-[10px] text-slate-400 mt-0.5">Pago único por vacante · Vía Yappy</p>
            <ul class="mt-6 space-y-2.5 text-xs text-slate-600 border-t border-slate-100 pt-5">
              <li class="flex items-center gap-2">✓ Top 10 candidatos ordenados</li>
              <li class="flex items-center gap-2">✓ WhatsApp y teléfono directo</li>
              <li class="flex items-center gap-2">✓ Desbloqueo de Video-Pitch 60s</li>
              <li class="flex items-center gap-2">✓ Certificado verificable EF SET</li>
              <li class="flex items-center gap-2">✓ Guía rápida convalidación Ley 513</li>
            </ul>
          </div>
          <div class="mt-8 pt-4 border-t border-slate-100">
            <a href="/moldeo-panama/talento-moldeable" class="w-full block text-center py-2.5 rounded-full text-xs font-bold bg-slate-900 hover:bg-[#002B7F] text-white shadow-clean transition-all">
              Desbloquear vía Yappy
            </a>
          </div>
        </div>

        <!-- Plan 3: Vacante Destacada -->
        <div class="bg-white border border-slate-200 rounded-3xl p-6 flex flex-col justify-between shadow-clean hover:shadow-clean-lg transition-all">
          <div>
            <span class="px-3 py-1 rounded-full text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">
              Máxima Visibilidad
            </span>
            <h3 class="text-lg font-bold text-slate-950 mt-3">Aviso Destacado + Red</h3>
            <p class="text-xs text-slate-500 mt-1">Ubicación preferencial y difusión universitaria.</p>
            <div class="mt-5 text-3xl font-black text-slate-950 font-mono">
              B/. 15.00
            </div>
            <p class="text-[10px] text-slate-400 mt-0.5">Por 15 días de difusión masiva</p>
            <ul class="mt-6 space-y-2.5 text-xs text-slate-600 border-t border-slate-100 pt-5">
              <li class="flex items-center gap-2">✓ Posición fija en la vitrina</li>
              <li class="flex items-center gap-2">✓ Difusión en WhatsApp de facultades</li>
              <li class="flex items-center gap-2">✓ Insignia visual destacada</li>
              <li class="flex items-center gap-2">✓ Enlace directo a tu web de empleo</li>
            </ul>
          </div>
          <div class="mt-8 pt-4 border-t border-slate-100">
            <a href="/moldeo-panama/publicar" class="w-full block text-center py-2.5 rounded-full text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-900 transition-colors">
              Destacar mi Vacante
            </a>
          </div>
        </div>

        <!-- Plan 4: Employer Branding Anual -->
        <div class="bg-white border border-slate-200 rounded-3xl p-6 flex flex-col justify-between shadow-clean hover:shadow-clean-lg transition-all">
          <div>
            <span class="px-3 py-1 rounded-full text-[10px] font-bold bg-amber-50 text-amber-800 border border-amber-200">
              Marca Empleadora
            </span>
            <h3 class="text-lg font-bold text-slate-950 mt-3">Sello Formador Verificado</h3>
            <p class="text-xs text-slate-500 mt-1">Presencia institucional ante universidades.</p>
            <div class="mt-5 text-3xl font-black text-slate-950 font-mono">
              B/. 49.00
            </div>
            <p class="text-[10px] text-slate-400 mt-0.5">Membresía anual corporativa</p>
            <ul class="mt-6 space-y-2.5 text-xs text-slate-600 border-t border-slate-100 pt-5">
              <li class="flex items-center gap-2">✓ Perfil corporativo de formación</li>
              <li class="flex items-center gap-2">✓ Publicaciones destacadas ilimitadas</li>
              <li class="flex items-center gap-2">✓ Informe de percepción estudiantil</li>
              <li class="flex items-center gap-2">✓ Factura fiscal panameña DGI</li>
            </ul>
          </div>
          <div class="mt-8 pt-4 border-t border-slate-100">
            <a href="mailto:empresas@moldeo.pa" class="w-full block text-center py-2.5 rounded-full text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-900 transition-colors">
              Consultar Membresía
            </a>
          </div>
        </div>

      </div>

    </div>
  </div>

  <!-- Yappy Comercial Callout -->
  <div class="py-16 bg-white border-y border-slate-200" id="yappy">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="w-16 h-16 rounded-3xl bg-blue-50 text-blue-700 border border-blue-200 flex items-center justify-center mx-auto text-3xl shadow-clean">
        💙
      </div>
      <h3 class="text-2xl font-black text-slate-950">
        Pagos Inmediatos sin Burocracia con Yappy Comercial
      </h3>
      <p class="text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">
        Paga tus reportes o servicios destacados directamente desde la App de Banco General buscando nuestro directorio comercial:
      </p>
      <div class="inline-block bg-slate-50 px-7 py-3 rounded-full border border-slate-200 font-mono text-xl font-bold text-slate-900 shadow-clean">
        @moldeopanama
      </div>
      <p class="text-xs text-slate-400">
        Para pagos corporativos internacionales aceptamos Visa, Mastercard y Amex vía Tilopay.
      </p>
    </div>
  </div>

  <!-- Calculadora Fiscal Integration -->
  <div class="py-16 md:py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <CalculadoraFiscal />
    </div>
  </div>

  <PactoFormadora />

</Layout>
