---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrianguloLegal from '../components/TrianguloLegal.astro';
import VacantesGrid from '../components/VacantesGrid.astro';
import CandidatosGrid from '../components/CandidatosGrid.astro';
import CalculadoraFiscal from '../components/CalculadoraFiscal.astro';
import TestRiasec from '../components/TestRiasec.astro';
import PactoFormadora from '../components/PactoFormadora.astro';
import KitRecursos from '../components/KitRecursos.astro';
import { faqs } from '../data/faq';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (path: string) => `${base}${path}`;

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Moldeo Panamá - Portal de Talento Universitario Cero Experiencia',
  url: 'https://irvinggaona124-code.github.io/moldeo-panama/',
  description: 'Conectamos a estudiantes universitarios de Panamá que jamás han trabajado con empresas dispuestas a formarlos bajo la Ley 513 de Pasantías y prácticas profesionales.',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://irvinggaona124-code.github.io/moldeo-panama/vacantes?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---

<Layout 
  title="Talento Universitario Cero Experiencia en Panamá (Ley 513 y Prácticas)"
  activePage="home"
  schema={pageSchema}
>
  
  <!-- Hero Section -->
  <Hero />

  <!-- Triángulo Legal de Contratación (Ventaja B2B) -->
  <TrianguloLegal />

  <!-- Vitrina Destacada de Vacantes Cero Experiencia -->
  <section class="py-16 md:py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-200 text-xs font-bold uppercase tracking-wider mb-2">
            Oportunidades Reales en Panamá
          </div>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-950 tracking-tight">
            Vitrina de Vacantes Cero Experiencia
          </h2>
          <p class="mt-2 text-sm text-slate-600 max-w-xl">
            Pasantías y prácticas profesionales verificadas en empresas formadoras en Ciudad de Panamá, Panamá Oeste, Colón, Chiriquí y multinacionales SEM.
          </p>
        </div>
        <a 
          href={u('/vacantes')} 
          class="inline-flex items-center gap-2 text-sm font-bold text-slate-900 hover:text-blue-700 group whitespace-nowrap"
        >
          <span>Ver las 30 vacantes activas</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <VacantesGrid limite={6} mostrarFiltrosCompletos={false} />

      <div class="mt-12 text-center">
        <a 
          href={u('/vacantes')} 
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full font-bold text-sm bg-white hover:bg-slate-50 text-slate-900 border border-slate-200 shadow-clean hover:shadow-clean-md transition-all active:scale-[0.98]"
        >
          <span>Explorar Catálogo Completo con Buscador y Filtros</span>
          <span>→</span>
        </a>
      </div>

    </div>
  </section>

  <!-- Calculadora Fiscal Interactiva -->
  <section class="py-16 md:py-24 bg-white border-y border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <CalculadoraFiscal />
    </div>
  </section>

  <!-- Directorio de Talento Moldeable (Anti-CV Anonimizado) -->
  <section class="py-16 md:py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold uppercase tracking-wider mb-2">
            Evaluación Objetiva por Potencial
          </div>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-950 tracking-tight">
            Directorio de Talento Moldeable (Anti-CV)
          </h2>
          <p class="mt-2 text-sm text-slate-600 max-w-xl">
            Universitarios pre-calificados con índice académico, inglés verificable EF SET, arquetipo RIASEC y video-pitch de 60 segundos.
          </p>
        </div>
        <a 
          href={u('/talento-moldeable')} 
          class="inline-flex items-center gap-2 text-sm font-bold text-slate-900 hover:text-emerald-700 group whitespace-nowrap"
        >
          <span>Ver los 15 perfiles listos para pasantía</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <CandidatosGrid limite={6} />

      <div class="mt-12 text-center">
        <a 
          href={u('/talento-moldeable')} 
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full font-bold text-sm bg-white hover:bg-slate-50 text-slate-900 border border-slate-200 shadow-clean hover:shadow-clean-md transition-all active:scale-[0.98]"
        >
          <span>Abrir Directorio de Candidatos Completo</span>
          <span>→</span>
        </a>
      </div>

    </div>
  </section>

  <!-- Test Vocacional RIASEC -->
  <section class="py-16 md:py-24 bg-white border-y border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <TestRiasec />
    </div>
  </section>

  <!-- El Pacto de Empresa Formadora -->
  <PactoFormadora />

  <!-- Kit de Práctica Profesional Descargable -->
  <section class="py-16 md:py-24 bg-white border-t border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-200 text-xs font-bold uppercase tracking-wider mb-3">
          Herramientas Gratuitas de Graduación
        </div>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-950 tracking-tight">
          Kit Oficial de Práctica Profesional y Ley 513
        </h2>
        <p class="mt-3 text-sm text-slate-600">
          Plantillas listas para usar para coordinar tu práctica con la facultad y la empresa sin tropiezos burocráticos.
        </p>
      </div>

      <KitRecursos />
    </div>
  </section>

  <!-- FAQs Sección -->
  <section class="py-16 md:py-24 bg-slate-50 border-t border-slate-200/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl sm:text-4xl font-black text-slate-950 tracking-tight">
          Preguntas Frecuentes sobre la Ley 513 y Prácticas en Panamá
        </h2>
        <p class="mt-2 text-xs sm:text-sm text-slate-500">
          Respuestas técnicas sobre exención de CSS, deducibilidad fiscal y convalidación universitaria.
        </p>
      </div>

      <div class="space-y-4">
        {faqs.slice(0, 6).map((faq) => (
          <details class="group bg-white border border-slate-200 rounded-2xl p-5 shadow-clean open:border-slate-300 transition-colors">
            <summary class="flex items-center justify-between cursor-pointer font-bold text-slate-900 text-sm list-none">
              <span class="pr-4">{faq.pregunta}</span>
              <span class="text-slate-400 font-bold group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-slate-600 leading-relaxed pt-3 border-t border-slate-100">
              {faq.respuesta}
            </p>
          </details>
        ))}
      </div>

    </div>
  </section>

</Layout>
